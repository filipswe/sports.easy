APP_ENV=development
APP_DATA_MODE=demo
# Compose overrides DATABASE_URL to its PostgreSQL service. Native development uses SQLite.
DATABASE_URL=sqlite:///./sports.db
POSTGRES_PASSWORD=replace-with-a-local-password
PUBLIC_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
API_INTERNAL_URL=http://api:8000
API_FOOTBALL_KEY=
# Free current-season fixtures and results from football-data.org.
FOOTBALL_PROVIDER=football-data
FOOTBALL_DATA_KEY=
ODDS_API_KEY=
LEAGUE_ID=39
LEAGUE_NAME=Premier League
SEASON=2026
ODDS_SPORT=soccer_epl
ODDS_REGION=eu
# Do not enable until your provider display, storage and retention rights are reviewed.
LIVE_RETENTION_APPROVED=false
PROVIDER_DAILY_BUDGET=80
ODDS_DAILY_BUDGET=64
ODDS_EVENT_DAILY_BUDGET=32
ODDS_MONTHLY_BUDGET=450
# Eight competitions: 16 credits per base sweep. Detail markets cost up to 5 per event.
# The monthly guard includes all priced markets and keeps usage below the free 500-credit plan.
POLL_SECONDS=14400
ODDS_POLL_SECONDS=259200
QUOTE_MAX_AGE_SECONDS=600
# Optional free Groq analyst. Keep the key server-side and out of Git.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
CHAT_DAILY_BUDGET=32
OPERATOR_NAME=
SUPPORT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=research@example.invalid
SMTP_STARTTLS=true
REGIONAL_NOTICE=Adults 18+ only. Check the rules where you live.

# Single bookmaker for live odds (provider account/key required).
ODDS_BOOKMAKER_KEY=pinnacle
