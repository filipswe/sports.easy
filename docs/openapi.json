  "components": {
    "schemas": {
      "Credentials": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials"
      },
      "DeleteAccount": {
        "properties": {
          "password": {
            "type": "string",
            "maxLength": 128,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "password"
        ],
        "title": "DeleteAccount"
      },
      "EmailInput": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "email"
        ],
        "title": "EmailInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Leg": {
        "properties": {
          "fixture_id": {
            "type": "string",
            "maxLength": 36,
            "title": "Fixture Id"
          },
          "market": {
            "type": "string",
            "maxLength": 32,
            "title": "Market"
          },
          "outcome": {
            "type": "string",
            "maxLength": 16,
            "title": "Outcome"
          },
          "user_odds": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1000.0,
                "exclusiveMinimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "User Odds"
          }
        },
        "type": "object",
        "required": [
          "fixture_id",
          "market",
          "outcome"
        ],
        "title": "Leg"
      },
      "ParlayInput": {
        "properties": {
          "legs": {
            "items": {
              "$ref": "#/components/schemas/Leg"
            },
            "type": "array",
            "maxItems": 8,
            "minItems": 1,
            "title": "Legs"
          }
        },
        "type": "object",
        "required": [
          "legs"
        ],
        "title": "ParlayInput"
      },
      "Preferences": {
        "properties": {
          "timezone": {
            "type": "string",
            "maxLength": 80,
            "title": "Timezone",
            "default": "Europe/Belgrade"
          },
          "odds_format": {
            "type": "string",
            "pattern": "^(decimal|american)$",
            "title": "Odds Format",
            "default": "decimal"
          },
          "leagues": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Leagues"
          },
          "filters": {
            "type": "string",
            "maxLength": 2000,
            "title": "Filters",
            "default": ""
          }
        },
        "type": "object",
        "title": "Preferences"
      },
      "SaveInput": {
        "properties": {
          "publication_id": {
            "type": "string",
            "title": "Publication Id"
          }
        },
        "type": "object",
        "required": [
          "publication_id"
        ],
        "title": "SaveInput"
      },
      "TokenInput": {
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 200,
            "minLength": 20,
            "title": "Token"
          },
          "password": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 12
              },
              {
                "type": "null"
              }
            ],
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "token"
        ],
        "title": "TokenInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
